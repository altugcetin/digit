// Session defaults: environment, layout and small fixes. Written by digit;
// change any of it in user.kdl, which loads after this.

environment {
{{qt}}{{gpu}}}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

// digit's own screen corners open the workspaces and Control Center.
gestures {
    hot-corners {
        off
    }
}
