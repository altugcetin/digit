spawn-at-startup "digit"

binds {
    Super+Space repeat=false allow-inhibiting=false { spawn "digitctl" "key" "notch"; }
    Alt+Space repeat=false allow-inhibiting=false { spawn "digitctl" "key" "launcher"; }
    Super+W repeat=false allow-inhibiting=false { spawn "digitctl" "key" "wallpaper"; }
    Alt+C repeat=false allow-inhibiting=false { spawn "digitctl" "key" "control"; }
    Alt+V repeat=false allow-inhibiting=false { spawn "digitctl" "key" "clipboard"; }
    Alt+Tab allow-inhibiting=false { spawn "digitctl" "key" "windows"; }
    Alt+Shift+Tab allow-inhibiting=false { spawn "digitctl" "key" "windows-back"; }
    Super+Tab repeat=false allow-inhibiting=false { spawn "digitctl" "key" "spaces"; }
    Super+Z repeat=false allow-inhibiting=false { spawn "digitctl" "key" "layouts"; }
    Alt+D repeat=false allow-inhibiting=false { spawn "digitctl" "key" "dock"; }
    Alt+Comma repeat=false allow-inhibiting=false { spawn "digitctl" "key" "settings"; }
    Super+L repeat=false allow-inhibiting=false { spawn "digitctl" "key" "lock"; }
    Super+Shift+E repeat=false allow-inhibiting=false { spawn "digitctl" "key" "session"; }
    Print repeat=false allow-inhibiting=false { spawn "digit-snap"; }
    Ctrl+Print repeat=false allow-inhibiting=false { spawn "digit-snap" "screen"; }
    Alt+Print repeat=false allow-inhibiting=false { spawn "digit-snap" "window"; }
    Shift+Print repeat=false allow-inhibiting=false { spawn "digit-snap" "--delay" "3"; }
    Super+Shift+S repeat=false allow-inhibiting=false { spawn "digit-snap"; }
    Super+E repeat=false allow-inhibiting=false { spawn "digit-files"; }
    Super+Alt+R repeat=false allow-inhibiting=false { spawn "digit-rec" "toggle"; }
    Super+Alt+S repeat=false allow-inhibiting=false { spawn "digit-rec" "save-replay"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "digitctl" "key" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "digitctl" "key" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "digitctl" "key" "mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "digitctl" "key" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "digitctl" "key" "brightness-down"; }
    XF86KbdBrightnessUp allow-when-locked=true { spawn "digitctl" "key" "kbd-up"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "digitctl" "key" "kbd-down"; }
}

gestures {
    hot-corners {
        off
    }
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=16 y=16 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id=r#"^dev\.digit\.Snap$"# title="^Screenshot$"
    open-floating true
}

window-rule {
    match app-id=r#"^dev\.digit\.Settings$"# title="^Welcome to Digit$"
    open-floating true
}

include optional=true "digit-windows.kdl"
